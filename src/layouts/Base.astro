---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { langFromUrl, switchLang, t, type Lang } from '@/i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: string;
  type?: 'website' | 'article';
  alt?: Partial<Record<Lang, string>>;
}
const lang = Astro.props.lang ?? langFromUrl(Astro.url);
const { title, description, ogImage = '/images/og-default.jpg', type = 'website' } = Astro.props;
const site = 'Die Neue';
const fullTitle = title.includes(site) ? title : `${title} – ${site}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altOverride = Astro.props.alt;
const altDe = new URL(switchLang(Astro.url, 'de', altOverride), Astro.site);
const altEn = new URL(switchLang(Astro.url, 'en', altOverride), Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService', '@id': `${Astro.site}#org`, name: 'Die Neue', url: Astro.site?.href, logo: new URL('/apple-touch-icon.png', Astro.site).href,
      description: lang === 'de' ? 'Marketing, KI-Beratung, Paid Social und Web – Chris Helmbrecht, München. Für Verbände, Mittelstand, Start-ups und Marken.' : 'Marketing, AI consulting, paid social and web – Chris Helmbrecht, Munich. For associations, mid-sized companies, start-ups and brands.',
      founder: { '@id': `${Astro.site}#chris` }, areaServed: ['DE', 'EU', 'US', 'NO'], email: 'info@dieneue.social', telephone: '+49 176 843 93190',
      address: { '@type': 'PostalAddress', streetAddress: 'Hauzenberger Str. 6', postalCode: '80687', addressLocality: 'München', addressCountry: 'DE' },
      knowsAbout: ['AI consulting', 'Marketing management', 'Paid social', 'Content production', 'Social media', 'Web design', 'SEO', 'GEO', 'Accessibility'],
      sameAs: ['https://www.linkedin.com/in/kollektiv', 'https://www.instagram.com/chrishelmbrecht'],
    },
    {
      '@type': 'Person', '@id': `${Astro.site}#chris`, name: 'Chris Helmbrecht', alternateName: 'Christian Helmbrecht', jobTitle: lang === 'de' ? 'Marketing- und KI-Berater' : 'Marketing and AI consultant',
      worksFor: { '@id': `${Astro.site}#org` }, url: new URL(lang === 'de' ? '/ueber-mich' : '/en/about', Astro.site).href, image: new URL('/images/chris-portrait.webp', Astro.site).href,
      knowsLanguage: ['de', 'en', 'ru'], sameAs: ['https://www.linkedin.com/in/kollektiv', 'https://www.instagram.com/chrishelmbrecht', 'https://www.chrishelmbrecht.de', 'https://www.chrishelmbrecht.com'],
    },
    { '@type': 'WebSite', url: Astro.site?.href, name: 'Die Neue', inLanguage: ['de', 'en'], publisher: { '@id': `${Astro.site}#org` } },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altDe} />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png?v=4" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#222222" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).skip}</a>
    <Header lang={lang} alt={altOverride} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
