---
import Base from '@/layouts/Base.astro';
import InsightsList from '@/components/InsightsList.astro';
---
<Base lang="de" title="Insights" description="Artikel zu Marketing, KI im Unternehmen, Social Media und Web – für Leute, die Entscheidungen treffen müssen, ohne IT-Abteilung.">
  <section class="section">
    <div class="wrap">
      <h1 style="font-size:var(--fs-6)">Insights</h1>
      <p class="lede">Was gerade in Marketing, KI und Social Media passiert – erklärt für Leute, die Entscheidungen treffen müssen und keine IT-Abteilung haben.</p>
    </div>
  </section>
  <section class="section--tight"><div class="wrap"><InsightsList lang="de" /></div></section>
</Base>
