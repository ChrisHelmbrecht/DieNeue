---
import Base from '@/layouts/Base.astro';
import InsightsList from '@/components/InsightsList.astro';
---
<Base lang="en" title="Insights" description="Articles on marketing, AI in business, social media and the web – for people who have to decide without an IT department.">
  <section class="section">
    <div class="wrap">
      <h1 style="font-size:var(--fs-6)">Insights</h1>
      <p class="lede">What is happening in marketing, AI and social media – explained for people who have to make decisions and don’t have an IT department.</p>
    </div>
  </section>
  <section class="section--tight"><div class="wrap"><InsightsList lang="en" /></div></section>
</Base>
