---
import { getCollection } from 'astro:content';
import { localePath, t, type Lang } from '@/i18n';
import { home } from '@/lib/copy';
import { videos, work } from '@/lib/media';
import InsightCard from '@/components/InsightCard.astro';
import Experience from '@/components/Experience.astro';
import MethodWheel from '@/components/MethodWheel.astro';
import VideoSlider from '@/components/VideoSlider.astro';
import WorkStrip from '@/components/WorkStrip.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const ui = t(lang);
const posts = (await getCollection('insights', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const de = lang === 'de';
---
<!-- HERO: Porträt + drei Probleme als Tabs -->
<section class="hero on-ink">
  <div class="wrap hero-grid">
    <div class="portrait">
      <picture>
        <source media="(max-width: 899px)" srcset="/images/chris-portrait-sq.webp" />
        <img src="/images/chris-portrait.webp" alt="Chris Helmbrecht" width="720" height="900" fetchpriority="high" />
      </picture>
    </div>
    <div class="hero-text">
      <h1 class="kicker">{c.hero.kicker}</h1>
      <p class="question">{c.hero.question}</p>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label={de ? 'Typische Probleme' : 'Typical problems'}>
          {c.hero.problems.map((p, i) => (
            <button role="tab" id={`tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}>{p.cta}</button>
          ))}
          <button type="button" class="pause" data-pause aria-pressed="false" aria-label={de ? 'Automatischen Wechsel anhalten' : 'Pause automatic rotation'} title={de ? 'Anhalten' : 'Pause'}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="i-pause"><rect x="3" y="2" width="3.5" height="12" fill="currentColor"/><rect x="9.5" y="2" width="3.5" height="12" fill="currentColor"/></svg>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="i-play"><path d="M4 2l10 6-10 6z" fill="currentColor"/></svg>
          </button>
        </div>
        <div class="stack">
        {c.hero.problems.map((p, i) => (
          <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} class:list={['panel', { active: i === 0 }]} aria-hidden={i !== 0 ? 'true' : undefined} inert={i !== 0 ? true : undefined}>
            <h2 class="statement">{p.statement}</h2>
            <p class="answer">{p.answer}</p>
            <a class="btn" href={localePath(lang, p.href)}>{de ? 'Mehr dazu' : 'Read more'}</a>
          </div>
        ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FILME -->
<section class="section reel on-ink">
  <div class="wrap">
    <h2>{de ? 'Filme' : 'Films'}</h2>
    <p class="lede">{de ? 'Imagefilme, Spots, Interviews, Social-Clips – von der Idee bis zum Schnitt.' : 'Image films, spots, interviews, social clips – from idea to final cut.'}</p>
    <VideoSlider videos={videos} lang={lang} />
  </div>
</section>

<!-- INTRO -->
<section class="section">
  <div class="wrap split">
    <h2>{c.intro.h}</h2>
    <div>
      {c.intro.p.map((p) => <p class="lede">{p}</p>)}
      <a href={localePath(lang, de ? '/ueber-mich' : '/about')}>{de ? 'Mehr über mich' : 'More about me'}</a>
    </div>
  </div>
</section>

<!-- ERFAHRUNG -->
<section class="section alt">
  <div class="wrap">
    <h2>{de ? 'Erfahrung' : 'Experience'}</h2>
    <p class="lede">{de ? 'Seit 1995 in Agenturen, Konzernen und eigenen Firmen. New York, Moskau, München.' : 'Since 1995 in agencies, corporations and my own companies. New York, Moscow, Munich.'}</p>
    <Experience lang={lang} />
  </div>
</section>

<!-- METHODE: interaktiver Kreis -->
<section class="section">
  <div class="wrap">
    <h2>{c.method.h}</h2>
    <p class="lede">{c.method.lede}</p>
    <MethodWheel steps={c.method.steps} lang={lang} />
    <a class="btn btn--ghost" href={localePath(lang, c.method.href)}>{c.method.more}</a>
  </div>
</section>

<!-- LEISTUNGEN -->
<section class="section alt">
  <div class="wrap">
    <h2>{c.services.h}</h2>
    <p class="lede">{c.services.lede}</p>
    <div class="services">
      {c.services.items.map((s) => (
        <a class="service" href={localePath(lang, s.href)}>
          <h3>{s.name}</h3>
          <p class="who">{s.who}</p>
          <p>{s.what}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ARBEITEN: Bildleiste -->
<section class="section on-ink work">
  <div class="wrap">
    <h2>{de ? 'Arbeiten' : 'Work'}</h2>
    <p class="lede">{de ? 'Filme, Kampagnen, Webseiten, Social – eine Auswahl aus drei Jahrzehnten.' : 'Films, campaigns, websites, social – a selection from three decades.'}</p>
  </div>
  <WorkStrip items={work[lang]} lang={lang} />
</section>

<!-- NETZWERK -->
<section class="section">
  <div class="wrap split">
    <h2>{c.network.h}</h2>
    <div>{c.network.p.map((p) => <p class="lede">{p}</p>)}</div>
  </div>
</section>

<!-- INSIGHTS -->
{posts.length > 0 && (
  <section class="section">
    <div class="wrap">
      <h2>Insights</h2>
      <div class="grid grid-3">
        {posts.map((p) => <InsightCard post={p} lang={lang} />)}
      </div>
      <p><a href={localePath(lang, '/insights')}>{ui.allInsights}</a></p>
    </div>
  </section>
)}

<!-- CTA -->
<section class="section cta">
  <div class="wrap">
    <h2>{c.cta.h}</h2>
    <p class="lede">{c.cta.p}</p>
    <a class="btn" href={localePath(lang, ui.contactPath)}>{c.cta.button}</a>
  </div>
</section>

<script>
  // Tabs im Hero: Klick, Pfeiltasten, und sanfter Auto-Wechsel bis zur ersten Interaktion
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const ROTATE_MS = 12000; // Standzeit pro Aussage
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    let timer: number | undefined;
    const show = (i: number) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { const on = i === j; p.classList.toggle('active', on); p.inert = !on; if (on) p.removeAttribute('aria-hidden'); else p.setAttribute('aria-hidden', 'true'); });
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } pause?.setAttribute('aria-pressed', 'true'); pause?.setAttribute('aria-label', pause.dataset.playLabel ?? ''); };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); show(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault(); stop();
        const n = (i + d + tabs.length) % tabs.length; show(n); tabs[n].focus();
      });
    });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => { i = (i + 1) % tabs.length; show(i); }, ROTATE_MS);
      pause?.setAttribute('aria-pressed', 'false');
      pause?.setAttribute('aria-label', pause.dataset.pauseLabel ?? '');
    };
    if (pause) { pause.dataset.pauseLabel = pause.getAttribute('aria-label') ?? ''; pause.dataset.playLabel = document.documentElement.lang === 'de' ? 'Automatischen Wechsel fortsetzen' : 'Resume automatic rotation'; }
    pause?.addEventListener('click', () => (timer ? stop() : start()));
    tabs.forEach((t, j) => t.addEventListener('click', () => { i = j; }));
    if (reduce) stop(); else start();
    root.addEventListener('focusin', (e) => { if ((e.target as HTMLElement) !== pause) stop(); });
  });
</script>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: var(--gutter); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 4fr 7fr; } }
  .portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--radius); background: var(--ink-2); }
  @media (max-width: 899px) { .portrait { max-width: 260px; } .portrait img { aspect-ratio: 1; } }
  .kicker { color: var(--on-ink-mute); font-family: var(--font-body); font-weight: 400; font-size: var(--fs-0); line-height: 1.4; letter-spacing: 0; margin-bottom: .4rem; }
  .question { font-family: var(--font-display); font-size: var(--fs-3); color: var(--on-ink-mute); margin-bottom: 1.2rem; }
  .tablist { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.6rem; }
  .tablist button { font: inherit; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-0); color: var(--on-ink-mute); background: transparent; border: 1px solid var(--ink-2); border-radius: 999px; padding: .5rem 1rem; cursor: pointer; }
  .tablist button[aria-selected='true'] { color: #fff; border-color: var(--signal-light); background: var(--signal); }
  .tablist button:hover { color: #fff; }
  .hero .statement { font-size: var(--fs-7); font-weight: 700; max-width: 20ch; color: #fff; margin-bottom: 1rem; }
  .answer { font-size: var(--fs-2); line-height: 1.45; max-width: 50ch; color: var(--on-ink); }
  .pause { margin-left: auto; width: 2.1rem; height: 2.1rem; border-radius: 50%; border: 1px solid var(--ink-2); background: transparent; color: var(--on-ink-mute); display: grid; place-content: center; cursor: pointer; }
  .pause:hover { color: #fff; border-color: var(--on-ink-mute); }
  .pause svg { width: 14px; height: 14px; max-width: none; }
  .pause .i-play { display: none; }
  .pause[aria-pressed='true'] .i-play { display: block; }
  .pause[aria-pressed='true'] .i-pause { display: none; }
  /* Alle Aussagen liegen übereinander im selben Rasterfeld: Höhe = längste Aussage, kein Springen */
  .stack { display: grid; }
  /* Erst ausblenden (0,9 s), dann einblenden (1,2 s) – nie zwei Texte gleichzeitig */
  .panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity .9s ease-in, visibility 0s linear .9s; }
  .panel.active { opacity: 1; visibility: visible; transition: opacity 1.2s ease-out .9s, visibility 0s linear .9s; }
  @media (prefers-reduced-motion: reduce) { .panel, .panel.active { transition: none; } }

  .reel { padding-top: 0; }
  .hero { padding-bottom: clamp(2rem, 5vw, 4rem); }

  .services { display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); border-top: 1px solid var(--line); margin-top: 2rem; }
  .service { text-decoration: none; padding: 1.8rem 1.4rem 1.8rem 0; border-bottom: 1px solid var(--line); }
  .service + .service { border-left: 1px solid var(--line); padding-left: 1.4rem; }
  @media (max-width: 700px) { .service + .service { border-left: 0; padding-left: 0; } }
  .service:hover h3 { color: var(--signal); }
  .who { color: var(--mute); }


  .cta { background: var(--signal); color: #fff; }
  .cta .btn { background: #fff; color: var(--signal); border-color: #fff; }
  .cta .btn:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cta .lede { color: #f3d3cf; }
</style>
