---
import { getCollection } from 'astro:content';
import { localePath, t, type Lang } from '@/i18n';
import { home } from '@/lib/copy';
import { videos, work } from '@/lib/media';
import InsightCard from '@/components/InsightCard.astro';
import VideoSlider from '@/components/VideoSlider.astro';
import WorkList from '@/components/WorkList.astro';
import { topBrands } from '@/lib/experience';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const ui = t(lang);
const posts = (await getCollection('insights', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const de = lang === 'de';
const half = Math.ceil(topBrands.length / 2);
const brandRows = [topBrands.slice(0, half), topBrands.slice(half)];
---
<!-- HERO: die drei Probleme groß, Porträt als Spalte, Logo und Wortmarke als Gestaltung -->
<section class="hero on-ink" data-hero>
  <div class="hero-logo" data-rotate="0.045" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="kicker">{c.hero.kicker}</h1>
      <p class="question">{c.hero.question}</p>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label={de ? 'Typische Probleme' : 'Typical problems'}>
          {c.hero.problems.map((p, i) => (
            <button role="tab" id={`tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}>{p.cta}</button>
          ))}
          <button type="button" class="pause" data-pause aria-pressed="false" aria-label={de ? 'Automatischen Wechsel anhalten' : 'Pause automatic rotation'} title={de ? 'Anhalten' : 'Pause'}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="i-pause"><rect x="3" y="2" width="3.5" height="12" fill="currentColor"/><rect x="9.5" y="2" width="3.5" height="12" fill="currentColor"/></svg>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="i-play"><path d="M4 2l10 6-10 6z" fill="currentColor"/></svg>
          </button>
        </div>
        <div class="stack">
        {c.hero.problems.map((p, i) => (
          <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} class:list={['panel', { active: i === 0 }]} aria-hidden={i !== 0 ? 'true' : undefined} inert={i !== 0 ? true : undefined}>
            <h2 class="statement">{p.statement}</h2>
            <p class="answer">{p.answer}</p>
            <p class="actions">
              <a class="btn" href={localePath(lang, ui.contactPath)}>{de ? 'Schreib mir' : 'Get in touch'}</a>
              <a class="btn btn--ghost" href={localePath(lang, p.href)}>{de ? 'Mehr dazu' : 'Read more'}</a>
            </p>
          </div>
        ))}
        </div>
      </div>
    </div>
    <figure class="hero-portrait">
      <div class="block" data-parallax="-0.06" aria-hidden="true"></div>
      <picture>
        <img src="/images/hero-chris-m.webp" alt="Chris Helmbrecht" width="760" height="902" fetchpriority="high" />
      </picture>
      <figcaption>Chris Helmbrecht</figcaption>
    </figure>
  </div>
  <p class="stations" aria-hidden="true"><span></span>New York — {de ? 'Moskau' : 'Moscow'} — {de ? 'München' : 'Munich'} · {de ? 'seit 1995' : 'since 1995'}</p>
  <div class="wordmark" data-shift="-0.18" aria-hidden="true">Die Neue</div>
</section>

<div class="after">
<div class="draw" data-draw></div>
<!-- LEISTUNGEN: große Zeilen -->
<section class="section">
  <div class="wrap">
    <h2>{c.services.h}</h2>
    <p class="lede">{c.services.lede}</p>
    <div class="services" data-reveal-group>
      {c.services.items.map((s, i) => (
        <a class="service" href={localePath(lang, s.href)}>
          <span class="num">0{i + 1}</span>
          <h3>{s.name}</h3>
          <div class="txt"><p class="who">{s.who}</p><p>{s.what}</p></div>
          <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 18L18 6M8 6h10v10"/></svg></span>
        </a>
      ))}
    </div>
    <p class="more"><a class="btn btn--ghost" href={localePath(lang, c.method.href)}>{de ? 'So arbeite ich: Analyse, Lösung, Umsetzung, Messen' : 'How I work: analysis, solution, execution, measurement'}</a></p>
  </div>
</section>


<!-- ARBEITEN: Bild bleibt stehen, Liste scrollt, Bild wechselt mit dem Eintrag -->
<section class="section on-ink work">
  <div class="wrap">
    <h2>{de ? 'Arbeiten' : 'Work'}</h2>
    <p class="lede">{de ? 'Filme, Kampagnen, Webseiten, Social – eine Auswahl aus drei Jahrzehnten.' : 'Films, campaigns, websites, social – a selection from three decades.'}</p>
    <WorkList items={work[lang]} lang={lang} />
  </div>
  <div class="wrap"><p class="more"><a class="btn btn--ghost" href={localePath(lang, '/cases')}>{de ? 'Alle Cases mit Zahlen' : 'All cases with numbers'}</a></p></div>
</section>


<!-- FILME -->
<section class="section reel on-ink">
  <div class="wrap">
    <h2>{de ? 'Filme' : 'Films'}</h2>
    <p class="lede">{de ? 'Imagefilme, Spots, Interviews, Social-Clips – von der Idee bis zum Schnitt.' : 'Image films, spots, interviews, social clips – from idea to final cut.'}</p>
    <div data-reveal><VideoSlider videos={videos} lang={lang} /></div>
  </div>
</section>

<div class="draw" data-draw></div>

<!-- INTRO -->
<section class="section intro">
  <div class="wrap split">
    <h2>{c.intro.h}</h2>
    <div>
      {c.intro.p.map((p) => <p class="lede">{p}</p>)}
      <a class="btn btn--ghost" href={localePath(lang, de ? '/ueber-mich' : '/about')}>{de ? 'Mehr über mich' : 'More about me'}</a>
    </div>
  </div>
</section>

<!-- MARKEN: zwei Laufbänder -->
<div class="brands">
  <p class="sr-only">{de ? 'Marken, für die ich gearbeitet habe: ' : 'Brands I have worked for: '}{topBrands.join(', ')}</p>
  {brandRows.map((row, r) => (
    <div class:list={['mq', { outline: r === 1 }]} data-marquee data-speed="45" data-dir={r === 0 ? 1 : -1} aria-hidden="true">
      <div class="mq-track">{[0, 1, 2].map(() => <span>{row.map((b) => <>{b}<i></i></>)}</span>)}</div>
    </div>
  ))}
</div>

<!-- INSIGHTS -->
{posts.length > 0 && (
  <section class="section alt insights">
    <div class="wrap">
      <h2>Insights</h2>
      <div class="grid grid-3">
        {posts.map((p) => <InsightCard post={p} lang={lang} />)}
      </div>
      <p><a class="btn btn--ghost" href={localePath(lang, '/insights')}>{ui.allInsights}</a></p>
    </div>
  </section>
)}
</div>

<script>
  // Tabs im Hero: Klick, Pfeiltasten, und sanfter Auto-Wechsel bis zur ersten Interaktion
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const ROTATE_MS = 12000; // Standzeit pro Aussage
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    let timer: number | undefined;
    const show = (i: number) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { const on = i === j; p.classList.toggle('active', on); p.inert = !on; if (on) p.removeAttribute('aria-hidden'); else p.setAttribute('aria-hidden', 'true'); });
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } pause?.setAttribute('aria-pressed', 'true'); pause?.setAttribute('aria-label', pause.dataset.playLabel ?? ''); };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); show(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault(); stop();
        const n = (i + d + tabs.length) % tabs.length; show(n); tabs[n].focus();
      });
    });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => { i = (i + 1) % tabs.length; show(i); }, ROTATE_MS);
      pause?.setAttribute('aria-pressed', 'false');
      pause?.setAttribute('aria-label', pause.dataset.pauseLabel ?? '');
    };
    if (pause) { pause.dataset.pauseLabel = pause.getAttribute('aria-label') ?? ''; pause.dataset.playLabel = document.documentElement.lang === 'de' ? 'Automatischen Wechsel fortsetzen' : 'Resume automatic rotation'; }
    pause?.addEventListener('click', () => (timer ? stop() : start()));
    tabs.forEach((t, j) => t.addEventListener('click', () => { i = j; }));
    if (reduce) stop(); else start();
    root.addEventListener('focusin', (e) => { if ((e.target as HTMLElement) !== pause) stop(); });
  });
</script>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; padding-top: clamp(5.5rem, 8vw, 7rem); min-height: 100svh; display: flex; flex-direction: column; }
  .hero-logo { position: absolute; z-index: -1; right: -14vw; top: -18vw; width: 62vw; aspect-ratio: 1; background: var(--ink-2); opacity: .55; -webkit-mask: url(/logo.svg) center / contain no-repeat; mask: url(/logo.svg) center / contain no-repeat; will-change: transform; }
  .hero-grid { display: grid; gap: clamp(2rem, 5vw, 5rem); grid-template-columns: 1fr; align-items: center; flex: 1; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 3.6fr); } }
  .kicker { color: var(--on-ink-mute); font-family: var(--font-body); font-weight: 400; font-size: var(--fs-0); line-height: 1.4; letter-spacing: 0; margin-bottom: 1rem; }
  .hero-portrait { position: relative; margin: 0 1.2rem 0 0; }
  .hero-portrait .block { position: absolute; inset: 1.4rem -1.2rem -1.4rem 1.2rem; background: var(--signal); }
  .hero-portrait img { position: relative; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 12%; filter: grayscale(1) contrast(1.08); }
  .hero-portrait figcaption { position: absolute; left: 0; bottom: -1.4rem; transform: translateY(100%); font-size: var(--fs-0); color: var(--on-ink-mute); }
  @media (max-width: 899px) { .hero-portrait { max-width: 300px; } .hero-portrait img { aspect-ratio: 1; } }
  .stations { display: flex; align-items: center; gap: 1rem; max-width: none; margin: clamp(2.2rem, 3.5vw, 3rem) 0 0; padding-inline: var(--gutter); font-family: var(--font-display); font-weight: 500; font-size: var(--fs-0); letter-spacing: .04em; text-transform: uppercase; color: var(--on-ink-mute); }
  .stations span { width: 3rem; height: 2px; background: var(--signal-light); }
  .wordmark { font-family: var(--font-display); font-weight: 700; font-size: clamp(6rem, 21vw, 22rem); line-height: .74; height: .6em; overflow: hidden; white-space: nowrap; letter-spacing: -0.05em; color: var(--ink-2); padding-left: var(--gutter); margin-top: 1rem; will-change: transform; user-select: none; }
  .after { position: relative; z-index: 1; background: var(--paper); }

  /* Drei Probleme */
  .question { font-family: var(--font-display); font-size: var(--fs-3); color: var(--on-ink-mute); margin-bottom: 1.2rem; }
  .tablist { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .tablist button { font: inherit; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-0); color: var(--on-ink-mute); background: transparent; border: 1px solid var(--ink-2); border-radius: 999px; padding: .55rem 1.1rem; cursor: pointer; transition: color .2s, background .2s, border-color .2s; }
  .tablist button[aria-selected='true'] { color: #fff; border-color: var(--signal-light); background: var(--signal); }
  .tablist button:hover { color: #fff; }
  .hero .statement { font-size: clamp(2.3rem, 5.2vw, 4.8rem); line-height: 1; font-weight: 600; letter-spacing: -0.025em; max-width: 22ch; color: #fff; margin-bottom: 1.2rem; }
  .answer { font-size: var(--fs-2); line-height: 1.45; max-width: 50ch; color: var(--on-ink); }
  .pause { margin-left: auto; width: 2.1rem; height: 2.1rem; border-radius: 50%; border: 1px solid var(--ink-2); background: transparent; color: var(--on-ink-mute); display: grid; place-content: center; cursor: pointer; }
  .pause:hover { color: #fff; border-color: var(--on-ink-mute); }
  .pause svg { width: 14px; height: 14px; max-width: none; }
  .pause .i-play { display: none; }
  .pause[aria-pressed='true'] .i-play { display: block; }
  .pause[aria-pressed='true'] .i-pause { display: none; }
  /* Alle Aussagen liegen übereinander im selben Rasterfeld: Höhe = längste Aussage, kein Springen */
  .stack { display: grid; }
  /* Erst ausblenden (0,9 s), dann einblenden (1,2 s) – nie zwei Texte gleichzeitig */
  .panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity .9s ease-in, transform .9s ease-in, visibility 0s linear .9s; }
  .panel.active { opacity: 1; visibility: visible; transform: none; transition: opacity 1.2s ease-out .9s, transform 1.2s cubic-bezier(.2, .7, .2, 1) .9s, visibility 0s linear .9s; }
  @media (prefers-reduced-motion: reduce) { .panel, .panel.active { transition: none; transform: none; } }

  .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; }
  .hero .btn--ghost, .work .btn--ghost { color: #fff; border-color: var(--on-ink-mute); }
  .more { margin-top: 2.2rem; max-width: none; }
  .reel { padding-top: 0; }
  .section :global(h2) { font-size: clamp(2.074rem, 4vw, 3.4rem); letter-spacing: -0.025em; }

  /* Marken-Laufbänder */
  .brands { padding-block: clamp(1rem, 3vw, 2.5rem) clamp(3.5rem, 8vw, 7rem); font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 5.2vw, 4.6rem); line-height: 1.15; letter-spacing: -0.02em; }
  .brands i { display: inline-block; width: .22em; height: .22em; border-radius: 50%; background: var(--signal); margin: 0 .55em; vertical-align: middle; }
  .brands .outline { color: transparent; -webkit-text-stroke: 1px var(--mute); }

  /* Leistungen als Zeilen */
  .services { border-top: 1px solid var(--line); margin-top: 2.5rem; }
  .service { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 5fr) minmax(0, 6fr) 4rem; gap: 1.5rem; align-items: center; padding: clamp(1.6rem, 3.2vw, 3rem) 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; transition: padding .45s cubic-bezier(.2, .8, .2, 1), color .3s; }
  .service::before { content: ''; position: absolute; inset: 0 calc(-1 * var(--gutter)); background: var(--ink); transform: scaleY(0); transform-origin: bottom; transition: transform .45s cubic-bezier(.2, .8, .2, 1); z-index: 0; }
  .service > * { position: relative; z-index: 1; }
  .service .num { font-family: var(--font-display); color: var(--mute); font-size: var(--fs-0); }
  .service h3 { font-size: clamp(1.5rem, 3vw, 2.6rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .service p { margin: 0; max-width: 46ch; }
  .who { color: var(--mute); margin-bottom: .35rem !important; transition: color .3s; }
  .go { width: 3.4rem; height: 3.4rem; border-radius: 50%; border: 1px solid currentColor; display: grid; place-content: center; justify-self: end; transition: background .3s, border-color .3s, transform .45s cubic-bezier(.2, .8, .2, 1); }
  @media (hover: hover) {
    .service:hover { color: var(--on-ink); padding-inline: 1rem; }
    .service:hover::before { transform: scaleY(1); }
    .service:hover .who, .service:hover .num { color: var(--on-ink-mute); }
    .service:hover .go { background: var(--signal); border-color: var(--signal); transform: rotate(45deg); }
  }
  @media (max-width: 820px) {
    .service { grid-template-columns: 2.2rem 1fr 2.8rem; gap: .6rem 1rem; }
    .service .txt { grid-column: 2 / -1; grid-row: 2; }
    .go { width: 2.6rem; height: 2.6rem; }
  }

</style>
