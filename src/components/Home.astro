---
import { getCollection } from 'astro:content';
import { localePath, t, type Lang } from '@/i18n';
import { home } from '@/lib/copy';
import { showreel, work } from '@/lib/media';
import InsightCard from '@/components/InsightCard.astro';
import MethodWheel from '@/components/MethodWheel.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import WorkStrip from '@/components/WorkStrip.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const ui = t(lang);
const posts = (await getCollection('insights', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const de = lang === 'de';
---
<!-- HERO: Porträt + drei Probleme als Tabs -->
<section class="hero on-ink">
  <div class="wrap hero-grid">
    <div class="portrait">
      <img src="/images/chris-portrait.svg" alt={de ? 'Chris Helmbrecht' : 'Chris Helmbrecht'} width="720" height="900" fetchpriority="high" />
    </div>
    <div class="hero-text">
      <p class="kicker">{c.hero.kicker}</p>
      <p class="question">{c.hero.question}</p>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label={de ? 'Typische Probleme' : 'Typical problems'}>
          {c.hero.problems.map((p, i) => (
            <button role="tab" id={`tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}>{p.cta}</button>
          ))}
        </div>
        {c.hero.problems.map((p, i) => (
          <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
            <h1>{p.statement}</h1>
            <p class="answer">{p.answer}</p>
            <a class="btn" href={localePath(lang, p.href)}>{de ? 'Mehr dazu' : 'Read more'}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SHOWREEL -->
<section class="section--tight reel">
  <div class="wrap">
    <VideoFacade video={showreel} lang={lang} />
  </div>
</section>

<!-- INTRO -->
<section class="section">
  <div class="wrap split">
    <h2>{c.intro.h}</h2>
    <div>
      {c.intro.p.map((p) => <p class="lede">{p}</p>)}
      <a href={localePath(lang, de ? '/ueber-mich' : '/about')}>{de ? 'Mehr über mich' : 'More about me'}</a>
    </div>
  </div>
</section>

<!-- METHODE: interaktiver Kreis -->
<section class="section alt">
  <div class="wrap">
    <h2>{c.method.h}</h2>
    <p class="lede">{c.method.lede}</p>
    <MethodWheel steps={c.method.steps} lang={lang} />
    <a class="btn btn--ghost" href={localePath(lang, c.method.href)}>{c.method.more}</a>
  </div>
</section>

<!-- LEISTUNGEN -->
<section class="section">
  <div class="wrap">
    <h2>{c.services.h}</h2>
    <p class="lede">{c.services.lede}</p>
    <div class="services">
      {c.services.items.map((s) => (
        <a class="service" href={localePath(lang, s.href)}>
          <h3>{s.name}</h3>
          <p class="who">{s.who}</p>
          <p>{s.what}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ARBEITEN: Bildleiste -->
<section class="section on-ink work">
  <div class="wrap">
    <h2>{de ? 'Arbeiten' : 'Work'}</h2>
    <p class="lede">{de ? 'Filme, Kampagnen, Webseiten, Social – eine Auswahl aus den letzten Jahren.' : 'Films, campaigns, websites, social – a selection from recent years.'}</p>
  </div>
  <WorkStrip items={work[lang]} lang={lang} />
</section>

<!-- NETZWERK -->
<section class="section">
  <div class="wrap split">
    <h2>{c.network.h}</h2>
    <div>{c.network.p.map((p) => <p class="lede">{p}</p>)}</div>
  </div>
</section>

<!-- KUNDEN: Laufband -->
<section class="section--tight alt clients-band">
  <div class="wrap">
    <p class="lede">{c.proof.lede}</p>
  </div>
  <div class="marquee" aria-label={c.proof.h}>
    <ul>
      {c.proof.clients.map((n) => <li>{n}</li>)}
      {c.proof.clients.map((n) => <li aria-hidden="true">{n}</li>)}
    </ul>
  </div>
</section>

<!-- INSIGHTS -->
{posts.length > 0 && (
  <section class="section">
    <div class="wrap">
      <h2>Insights</h2>
      <div class="grid grid-3">
        {posts.map((p) => <InsightCard post={p} lang={lang} />)}
      </div>
      <p><a href={localePath(lang, '/insights')}>{ui.allInsights}</a></p>
    </div>
  </section>
)}

<!-- CTA -->
<section class="section cta">
  <div class="wrap">
    <h2>{c.cta.h}</h2>
    <p class="lede">{c.cta.p}</p>
    <a class="btn" href={localePath(lang, ui.contactPath)}>{c.cta.button}</a>
  </div>
</section>

<script>
  // Tabs im Hero: Klick, Pfeiltasten, und sanfter Auto-Wechsel bis zur ersten Interaktion
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    let timer: number | undefined;
    const show = (i: number) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); show(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault(); stop();
        const n = (i + d + tabs.length) % tabs.length; show(n); tabs[n].focus();
      });
    });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      let i = 0;
      timer = window.setInterval(() => { i = (i + 1) % tabs.length; show(i); }, 6000);
      root.addEventListener('pointerenter', stop, { once: true });
    }
  });
</script>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: var(--gutter); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 4fr 7fr; } }
  .portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--radius); filter: grayscale(1) contrast(1.05); background: var(--ink-2); }
  @media (max-width: 899px) { .portrait { max-width: 260px; } .portrait img { aspect-ratio: 1; } }
  .kicker { color: var(--on-ink-mute); font-size: var(--fs-0); margin-bottom: .4rem; }
  .question { font-family: var(--font-display); font-size: var(--fs-3); color: var(--on-ink-mute); margin-bottom: 1.2rem; }
  .tablist { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.6rem; }
  .tablist button { font: inherit; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-0); color: var(--on-ink-mute); background: transparent; border: 1px solid var(--ink-2); border-radius: 999px; padding: .5rem 1rem; cursor: pointer; }
  .tablist button[aria-selected='true'] { color: #fff; border-color: var(--signal); background: var(--signal); }
  .tablist button:hover { color: #fff; }
  .hero h1 { font-size: var(--fs-7); max-width: 20ch; color: #fff; margin-bottom: 1rem; }
  .answer { font-size: var(--fs-2); line-height: 1.45; max-width: 50ch; color: var(--on-ink); }
  [role=tabpanel] { animation: fade .35s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { [role=tabpanel] { animation: none; } }

  .reel { background: var(--ink); padding-top: 0; }

  .services { display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); border-top: 1px solid var(--line); margin-top: 2rem; }
  .service { text-decoration: none; padding: 1.8rem 1.4rem 1.8rem 0; border-bottom: 1px solid var(--line); }
  .service + .service { border-left: 1px solid var(--line); padding-left: 1.4rem; }
  @media (max-width: 700px) { .service + .service { border-left: 0; padding-left: 0; } }
  .service:hover h3 { color: var(--signal); }
  .who { color: var(--mute); }

  .marquee { overflow: hidden; margin-top: 1.5rem; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 3rem; width: max-content; max-width: none; animation: scroll 40s linear infinite; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-3); white-space: nowrap; }
  .marquee:hover ul { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee ul { animation: none; flex-wrap: wrap; width: auto; gap: 1rem 2rem; } .marquee { mask-image: none; } }

  .cta { background: var(--signal); color: #fff; }
  .cta .btn { background: #fff; color: var(--signal); border-color: #fff; }
  .cta .btn:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cta .lede { color: #dfe4ff; }
</style>
