---
/* Arbeiten: Das Bild bleibt stehen, die Liste scrollt, das Bild wechselt mit dem Eintrag in der Bildmitte (oder unter der Maus). */
import type { Lang } from '@/i18n';
import type { WorkItem } from '@/lib/media';
interface Props { items: WorkItem[]; lang: Lang }
const { items } = Astro.props;
---
<div class="wl" data-worklist>
  <div class="frame" aria-hidden="true">
    {items.map((w, i) => <img src={w.image} alt="" width="640" height="400" loading="lazy" class:list={{ on: i === 0 }} />)}
    <span class="count"><b>01</b> / {String(items.length).padStart(2, '0')}</span>
  </div>
  <ul>
    {items.map((w, i) => (
      <li data-i={i} class:list={{ on: i === 0 }}>
        {w.href
          ? <a href={w.href}><strong>{w.client}</strong><span>{w.kind}</span></a>
          : <div class="row"><strong>{w.client}</strong><span>{w.kind}</span></div>}
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-worklist]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('li')];
    const imgs = [...root.querySelectorAll<HTMLElement>('.frame img')];
    const count = root.querySelector<HTMLElement>('.count b')!;
    let cur = 0, ticking = false;
    const set = (i: number) => {
      if (i === cur) return; cur = i;
      rows.forEach((r, j) => r.classList.toggle('on', j === i));
      imgs.forEach((im, j) => im.classList.toggle('on', j === i));
      count.textContent = String(i + 1).padStart(2, '0');
    };
    const pick = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const line = innerHeight * (matchMedia('(min-width: 900px)').matches ? 0.5 : 0.68);
      let best = 0, d = Infinity;
      rows.forEach((row, i) => { const b = row.getBoundingClientRect(); const dist = Math.abs((b.top + b.bottom) / 2 - line); if (dist < d) { d = dist; best = i; } });
      set(best);
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(pick); } }, { passive: true });
    rows.forEach((row, i) => row.addEventListener('mouseenter', () => set(i)));
  });
</script>

<style>
  .wl { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  .frame { position: sticky; top: 5rem; z-index: 2; aspect-ratio: 16 / 10; overflow: hidden; background: var(--ink-2); }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity .6s ease, transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .frame img.on { opacity: 1; transform: none; }
  .count { position: absolute; left: 0; bottom: 0; background: var(--signal); color: #fff; padding: .45rem .9rem; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-0); }
  ul { list-style: none; margin: 0; padding: 0; max-width: none; border-top: 1px solid var(--ink-2); }
  li { border-bottom: 1px solid var(--ink-2); margin: 0; }
  a, .row { display: grid; gap: .3rem; padding: clamp(1.3rem, 2.4vw, 2.1rem) 0 clamp(1.3rem, 2.4vw, 2.1rem) 0; text-decoration: none; color: var(--on-ink-mute); border-left: 3px solid transparent; transition: color .35s, padding .45s cubic-bezier(.2, .8, .2, 1), border-color .35s; }
  strong { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 3.1vw, 2.8rem); letter-spacing: -0.025em; line-height: 1.05; }
  span { font-size: var(--fs-0); }
  li.on a, li.on .row { color: #fff; padding-left: 1.2rem; border-left-color: var(--signal-light); }
  @media (min-width: 900px) {
    .wl { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .frame { top: 6.5rem; aspect-ratio: 4 / 3; }
  }
</style>
