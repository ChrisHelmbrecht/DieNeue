---
import { nav, t, localePath, type Lang } from '@/i18n';
import { home } from '@/lib/copy';
interface Props { lang: Lang; big?: boolean }
const { lang, big = false } = Astro.props;
const cta = home[lang].cta;
const ui = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer on-ink">
  {big && (
    <div class="wrap big">
      <h2 data-reveal><img src="/images/chris-avatar.webp" alt="" width="120" height="120" loading="lazy" />{cta.h}</h2>
      <p class="lede" data-reveal>{cta.p}</p>
      <div class="line"><a class="round" data-magnetic="0.35" href={localePath(lang, ui.contactPath)}>{cta.button}</a></div>
      <p class="pills">
        <a class="pill" data-magnetic="0.2" href="mailto:info@dieneue.social">info@dieneue.social</a>
        <a class="pill" data-magnetic="0.2" href="tel:+4917684393190">+49 176 843 93190</a>
      </p>
    </div>
  )}
  <div class="wrap grid grid-3">
    <div>
      <p class="brand">Die Neue</p>
      <p class="mute">{ui.tagline}</p>
      <p class="mute">Chris Helmbrecht · München<br /><a href="mailto:info@dieneue.social">info@dieneue.social</a><br /><a href="tel:+4917684393190">+49 176 843 93190</a></p>
    </div>
    <div>
      <ul>
        {nav[lang].map((i) => <li><a href={localePath(lang, i.href)}>{i.label}</a></li>)}
        <li><a href={localePath(lang, ui.contactPath)}>{ui.contact}</a></li>
      </ul>
    </div>
    <div>
      <ul>
        <li><a href="https://www.linkedin.com/in/kollektiv" rel="me noopener">LinkedIn</a></li>
        <li><a href={lang === 'de' ? 'https://www.chrishelmbrecht.de' : 'https://www.chrishelmbrecht.com'} rel="me noopener">{lang === 'de' ? 'chrishelmbrecht.de' : 'chrishelmbrecht.com'}</a></li>
        <li><a href="https://www.instagram.com/chrishelmbrecht" rel="me noopener">Instagram</a></li>
        {ui.footerLegal.map((label, i) => <li><a href={localePath(lang, ui.footerLegalPaths[i])}>{label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap copy mute">© {year} Chris Helmbrecht – Die Neue</div>
</footer>

<style>
  .site-footer { padding-block: 3.5rem 1.5rem; margin-top: 0; }
  .big { padding-block: clamp(3rem, 9vw, 8rem) clamp(3rem, 6vw, 5rem); }
  .big h2 { font-size: clamp(2.3rem, 7vw, 6.4rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; max-width: 14ch; margin-bottom: 1.5rem; }
  .big h2 img { display: inline-block; width: .82em; height: .82em; border-radius: 50%; object-fit: cover; margin-right: .22em; vertical-align: -0.06em; }
  .big .lede { color: var(--on-ink-mute); }
  .line { position: relative; border-top: 1px solid var(--ink-2); margin-top: clamp(4.5rem, 9vw, 8rem); }
  .round { position: absolute; right: clamp(0rem, 10vw, 12rem); top: 0; translate: 0 -50%; width: clamp(7.5rem, 13vw, 11.5rem); aspect-ratio: 1; border-radius: 50%; background: var(--signal); color: #fff; display: grid; place-content: center; text-align: center; padding: 1rem; font-family: var(--font-display); font-weight: 600; line-height: 1.15; transition: background .3s, transform .5s cubic-bezier(.2, .8, .2, 1); }
  .round:hover { background: var(--signal-hover); color: #fff; }
  .pills { display: flex; flex-wrap: wrap; gap: .8rem; margin: clamp(5rem, 9vw, 7.5rem) 0 0; max-width: none; }
  .pill { border: 1px solid var(--on-ink-mute); border-radius: 999px; padding: 1rem 1.8rem; font-family: var(--font-display); font-weight: 500; transition: background .3s, color .3s, border-color .3s, transform .5s cubic-bezier(.2, .8, .2, 1); }
  .pill:hover { background: var(--paper); color: var(--ink) !important; border-color: var(--paper); }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-3); margin-bottom: .3rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: .4rem; }
  a { text-decoration: none; }
  .copy { margin-top: 2.5rem; font-size: var(--fs-0); }
</style>
