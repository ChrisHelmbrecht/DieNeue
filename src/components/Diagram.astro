---
/* Inline-SVG-Diagramme, bewusst schlicht: Linien, Kreise, Text. Variante über `kind`. */
import type { Lang } from '@/i18n';
interface Props { kind: 'loop' | 'budget' | 'funnel' | 'network'; lang: Lang }
const { kind, lang } = Astro.props;
const de = lang === 'de';
const T = {
  loop: de
    ? { title: 'Der KI-Loop', steps: ['Briefing & Prompt', 'KI erstellt', 'Zweite KI prüft', 'Verbessern', 'Mensch prüft'], note: 'Erfahrung steckt im Prompt und in der letzten Prüfung. Dazwischen laufen die Modelle in Schleifen.' }
    : { title: 'The AI loop', steps: ['Brief & prompt', 'AI drafts', 'Second AI reviews', 'Improve', 'Human checks'], note: 'Experience sits in the prompt and in the final check. In between, the models run in loops.' },
  budget: de
    ? { title: 'So wird das Budget verteilt', rows: [['Strategie & Planung', 10], ['Content-Produktion', 40], ['Verbreitung (organisch + paid)', 30], ['Messen & nachsteuern', 20]], note: 'Beispielverteilung. Der Anteil wandert jeden Monat dorthin, wo die Zahlen am besten sind.' }
    : { title: 'How the budget is split', rows: [['Strategy & planning', 10], ['Content production', 40], ['Distribution (organic + paid)', 30], ['Measure & adjust', 20]], note: 'Example split. Each month the share moves to where the numbers are best.' },
  funnel: de
    ? { title: 'Wo Paid Social meistens scheitert', steps: ['Reichweite', 'Aufmerksamkeit', 'Klick', 'Anfrage', 'Kunde'], marks: [1, 3], note: 'Reichweite ist leicht zu kaufen. Aufmerksamkeit entscheidet der Content, die Anfrage entscheidet die Landingpage.' }
    : { title: 'Where paid social usually fails', steps: ['Reach', 'Attention', 'Click', 'Enquiry', 'Customer'], marks: [1, 3], note: 'Reach is easy to buy. Attention is decided by the content, the enquiry by the landing page.' },
  network: de
    ? { title: 'Wer mitarbeitet', center: 'Chris', ring: ['KI-Modelle', 'Art Director', 'Film & Foto', 'Entwicklung', 'Text', 'Media-Planung', 'Branding', 'Recht & Datenschutz'], note: 'Ein Ansprechpartner. Dahinter Werkzeuge und Leute, je nach Aufgabe.' }
    : { title: 'Who is involved', center: 'Chris', ring: ['AI models', 'Art director', 'Film & photo', 'Development', 'Copy', 'Media planning', 'Branding', 'Legal & privacy'], note: 'One point of contact. Behind it, tools and people depending on the task.' },
};
---
{kind === 'loop' && (() => { const t = T.loop; const n = t.steps.length; const cx = 200, cy = 190, r = 140; const pos = (i: number) => { const a = (-90 + i * 360 / n) * Math.PI / 180; return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) }; }; return (
  <figure class="dg">
    <svg viewBox="0 0 400 400" role="img" aria-label={t.title}>
      <circle cx={cx} cy={cy} r={r} class="ring" />
      {t.steps.map((s, i) => { const p = pos(i); const human = i === 0 || i === n - 1; return (
        <g transform={`translate(${p.x} ${p.y})`}>
          <circle r="30" class:list={['node', { human }]} />
          <text y="5" class="num">{i + 1}</text>
          <text y={i === 0 ? -42 : i === 2 || i === 3 ? 48 : 48} class="lbl">{s}</text>
        </g>
      ); })}
      <text x={cx} y={cy - 8} class="mid">{de ? 'Erfahrung' : 'Experience'}</text>
      <text x={cx} y={cy + 14} class="mid-sub">{de ? 'rein und raus' : 'in and out'}</text>
    </svg>
    <figcaption><strong>{t.title}.</strong> {t.note}</figcaption>
  </figure>
); })()}

{kind === 'budget' && (() => { const t = T.budget; return (
  <figure class="dg">
    <svg viewBox="0 0 400 230" role="img" aria-label={t.title}>
      {t.rows.map(([label, pct], i) => { const y = 20 + i * 52; const w = 240 * (pct as number) / 40; return (
        <g>
          <text x="0" y={y + 14} class="lbl-l">{label}</text>
          <rect x="0" y={y + 22} width="240" height="14" class="bar-bg" />
          <rect x="0" y={y + 22} width={w} height="14" class:list={['bar', { hi: i === 1 }]} />
          <text x="252" y={y + 34} class="pct">{pct} %</text>
        </g>
      ); })}
    </svg>
    <figcaption><strong>{t.title}.</strong> {t.note}</figcaption>
  </figure>
); })()}

{kind === 'funnel' && (() => { const t = T.funnel; const n = t.steps.length; return (
  <figure class="dg">
    <svg viewBox="0 0 400 300" role="img" aria-label={t.title}>
      {t.steps.map((s, i) => { const w = 340 - i * 60; const x = (400 - w) / 2; const y = 10 + i * 56; const mark = t.marks.includes(i); return (
        <g>
          <rect x={x} y={y} width={w} height="44" rx="4" class:list={['step', { mark }]} />
          <text x="200" y={y + 27} class:list={['step-lbl', { 'on-mark': mark }]}>{s}</text>
          {mark && <text x={x + w + 10} y={y + 27} class="mark-txt">{de ? '← hier' : '← here'}</text>}
        </g>
      ); })}
    </svg>
    <figcaption><strong>{t.title}.</strong> {t.note}</figcaption>
  </figure>
); })()}

{kind === 'network' && (() => { const t = T.network; const n = t.ring.length; const cx = 200, cy = 200, r = 140; return (
  <figure class="dg">
    <svg viewBox="0 0 400 400" role="img" aria-label={t.title}>
      {t.ring.map((s, i) => { const a = (-90 + i * 360 / n) * Math.PI / 180; const x = cx + r * Math.cos(a), y = cy + r * Math.sin(a); return (
        <g>
          <line x1={cx} y1={cy} x2={x} y2={y} class="spoke" />
          <circle cx={x} cy={y} r="34" class:list={['node', { ai: i === 0 }]} />
          <text x={x} y={y + 4} class="ring-lbl">{s}</text>
        </g>
      ); })}
      <circle cx={cx} cy={cy} r="40" class="node human" />
      <text x={cx} y={cy + 5} class="num">{t.center}</text>
    </svg>
    <figcaption><strong>{t.title}.</strong> {t.note}</figcaption>
  </figure>
); })()}

<style>
  .dg { margin: 0; }
  svg { width: 100%; max-width: 440px; height: auto; overflow: visible; display: block; }
  figcaption { margin-top: .8rem; font-size: var(--fs-0); color: var(--mute); max-width: 44ch; }
  .ring { fill: none; stroke: var(--line); stroke-width: 3; }
  .arrow { fill: none; stroke: var(--mute); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .node { fill: var(--paper); stroke: var(--ink); stroke-width: 3; }
  .node.human { fill: var(--signal); stroke: var(--signal); }
  .node.ai { fill: var(--ink); stroke: var(--ink); }
  .num { font-family: var(--font-display); font-weight: 700; font-size: 18px; text-anchor: middle; fill: var(--ink); }
  .human + .num, .node.human ~ .num { fill: #fff; }
  g:has(.human) .num { fill: #fff; }
  .lbl { font-family: var(--font-display); font-weight: 600; font-size: 14px; text-anchor: middle; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 6px; stroke-linejoin: round; }
  .mid { font-family: var(--font-display); font-weight: 700; font-size: 18px; text-anchor: middle; fill: var(--signal); }
  .mid-sub { font-size: 13px; text-anchor: middle; fill: var(--mute); }
  .lbl-l { font-family: var(--font-display); font-weight: 600; font-size: 14px; fill: var(--ink); }
  .bar-bg { fill: var(--line); }
  .bar { fill: var(--ink); }
  .bar.hi { fill: var(--signal); }
  .pct { font-family: var(--font-display); font-weight: 700; font-size: 14px; fill: var(--ink); }
  .step { fill: var(--paper-2); stroke: var(--line); }
  .step.mark { fill: var(--signal); stroke: var(--signal); }
  .step-lbl { font-family: var(--font-display); font-weight: 600; font-size: 15px; text-anchor: middle; fill: var(--ink); }
  .step-lbl.on-mark { fill: #fff; }
  .mark-txt { font-family: var(--font-display); font-weight: 700; font-size: 14px; fill: var(--signal); }
  .spoke { stroke: var(--line); stroke-width: 2; }
  .ring-lbl { font-family: var(--font-display); font-weight: 600; font-size: 11px; text-anchor: middle; fill: var(--ink); }
  g:has(.ai) .ring-lbl { fill: #fff; }
  :global(.on-ink) .lbl, :global(.on-ink) .lbl-l, :global(.on-ink) .pct, :global(.on-ink) .ring-lbl, :global(.on-ink) .num { fill: var(--on-ink); }
  :global(.on-ink) .node { fill: var(--ink); stroke: var(--on-ink); }
  :global(.on-ink) .node.human { fill: var(--signal); stroke: var(--signal); }
  :global(.on-ink) .node.ai { fill: var(--on-ink); stroke: var(--on-ink); }
  :global(.on-ink) g:has(.ai) .ring-lbl { fill: var(--ink); }
  :global(.on-ink) .ring, :global(.on-ink) .spoke { stroke: var(--ink-2); }
  :global(.on-ink) .lbl { stroke: var(--ink); }
  :global(.on-ink) figcaption { color: var(--on-ink-mute); }
</style>
