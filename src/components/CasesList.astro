---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { localePath, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const cases = (await getCollection('cases', (e) => e.data.lang === lang && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<section class="section">
  <div class="wrap">
    <h1>Cases</h1>
    <p class="lede">{de ? 'Ausgangslage, Lösung, Umsetzung, Ergebnis. Keine Hochglanz-Referenzen, sondern was tatsächlich passiert ist – mit Zahlen, wo es welche gibt.' : 'Situation, solution, execution, result. No glossy references – what actually happened, with numbers where there are any.'}</p>
  </div>
</section>
<section class="section--tight">
  <div class="wrap">
    <ul class="cases">
      {cases.map((c) => {
        const href = localePath(lang, `/cases/${c.data.slug}`);
        return (
          <li>
            <a href={href} class="card">
              {c.data.cover && <Image src={c.data.cover} alt={c.data.coverAlt ?? ''} width="960" height="600" />}
              <div class="body">
                <p class="client">{c.data.client} · {c.data.sector}</p>
                <h2>{c.data.title}</h2>
                <p>{c.data.summary}</p>
                {c.data.results.length > 0 && (
                  <dl class="kpis">
                    {c.data.results.slice(0, 2).map((r) => <div><dt>{r.value}</dt><dd>{r.label}</dd></div>)}
                  </dl>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  h1 { font-size: var(--fs-6); }
  .cases { list-style: none; margin: 0; padding: 0; max-width: none; display: grid; gap: 2.5rem; }
  .card { display: grid; gap: var(--gutter); text-decoration: none; grid-template-columns: 1fr; border-top: 1px solid var(--line); padding-top: 2rem; }
  @media (min-width: 820px) { .card { grid-template-columns: 5fr 7fr; } }
  .card img { aspect-ratio: 16/10; object-fit: cover; border-radius: var(--radius); }
  .client { color: var(--mute); font-size: var(--fs-0); margin-bottom: .3rem; }
  .card h2 { font-size: var(--fs-4); max-width: 24ch; }
  .card:hover h2 { color: var(--signal); }
  .kpis { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; margin: 1rem 0 0; }
  .kpis dt { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-4); color: var(--signal); line-height: 1; }
  .kpis dd { margin: .2rem 0 0; font-size: var(--fs-0); color: var(--mute); max-width: 24ch; }
</style>
