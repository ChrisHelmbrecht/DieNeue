---
/* Video-Platzhalter: lädt YouTube/Vimeo erst nach Klick (kein Tracking vorher, schnelle Seite) */
import type { Lang } from '@/i18n';
import type { Video } from '@/lib/media';
interface Props { video: Video; lang: Lang }
const { video, lang } = Astro.props;
const embed = video.provider === 'youtube'
  ? `https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`
  : `https://player.vimeo.com/video/${video.id}?autoplay=1&dnt=1`;
---
<div class="facade" data-embed={embed}>
  <img src={video.poster} alt="" width="1280" height="720" loading="lazy" />
  <button type="button" aria-label={lang === 'de' ? `Video abspielen: ${video.title[lang]}` : `Play video: ${video.title[lang]}`}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
  </button>
  <p class="caption">{video.title[lang]}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.facade').forEach((f) => {
    f.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = f.dataset.embed!;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.title = f.querySelector('.caption')?.textContent ?? 'Video';
      f.replaceChildren(iframe);
    });
  });
</script>

<style>
  .facade { position: relative; aspect-ratio: 16/9; background: var(--ink-2); border-radius: var(--radius); overflow: hidden; }
  .facade img, .facade :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  button { position: absolute; inset: 0; margin: auto; width: 5rem; height: 5rem; border-radius: 50%; border: 0; background: var(--signal); color: #fff; display: grid; place-content: center; cursor: pointer; transition: transform .15s; }
  button:hover { transform: scale(1.08); }
  .caption { position: absolute; left: 1rem; bottom: .6rem; margin: 0; color: #fff; font-family: var(--font-display); font-weight: 600; text-shadow: 0 1px 8px rgba(0,0,0,.6); }
</style>
