---
/* Video zum Artikel: Vorschaubild vom eigenen Server, YouTube (nocookie) lädt erst nach Klick.
   Darunter optional das Transkript zum Aufklappen – für Leser und für KI-Suchen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '@/i18n';
interface Props {
  youtubeId: string;
  title: string;
  poster?: ImageMetadata;
  transcript?: string;
  lang: Lang;
}
const { youtubeId, title, poster, transcript, lang } = Astro.props;
const de = lang === 'de';
const url = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
const paragraphs = (transcript ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<figure class="avideo" data-avideo data-url={url}>
  <div class="frame">
    {poster ? <Image src={poster} alt="" width="1200" height="675" /> : <div class="blank" />}
    <button type="button" class="play" aria-label={de ? `Video abspielen: ${title}` : `Play video: ${title}`}>
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    </button>
  </div>
  <figcaption>
    {de ? 'Video zum Artikel' : 'Video for this article'}{' · '}<a href={`https://www.youtube.com/watch?v=${youtubeId}`} rel="noopener">{de ? 'auf YouTube ansehen' : 'watch on YouTube'}</a>
    <span class="note">{de ? 'Beim Abspielen lädt der Player von YouTube.' : 'Playing loads the player from YouTube.'}</span>
  </figcaption>
  {paragraphs.length > 0 && (
    <details class="transcript">
      <summary>{de ? 'Transkript lesen' : 'Read transcript'}</summary>
      {paragraphs.map((p) => <p>{p}</p>)}
    </details>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-avideo]').forEach((root) => {
    root.querySelector('.play')?.addEventListener('click', () => {
      const frame = root.querySelector<HTMLElement>('.frame')!;
      const f = document.createElement('iframe');
      f.src = root.dataset.url!;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.title = 'Video';
      frame.replaceChildren(f);
      f.focus();
    });
  });
</script>

<style>
  .avideo { margin: 2rem 0 0; }
  .frame { position: relative; aspect-ratio: 16/9; background: var(--ink-2); border-radius: var(--radius); overflow: hidden; }
  .frame :global(img), .frame .blank, .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .play { position: absolute; inset: 0; margin: auto; width: 5rem; height: 5rem; border-radius: 50%; border: 0; background: var(--signal); color: #fff; display: grid; place-content: center; cursor: pointer; transition: transform .15s; }
  .play:hover { transform: scale(1.08); }
  figcaption { margin-top: .6rem; font-size: var(--fs-0); color: var(--mute); }
  .note { display: block; }
  .transcript { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .8rem; }
  .transcript summary { cursor: pointer; font-family: var(--font-display); font-weight: 600; }
  .transcript p { margin-top: .8rem; }
</style>
